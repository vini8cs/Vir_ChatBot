# Vir ChatBot — copy this file to .env and fill in the values

# Provider (options: gemini | local)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001

# API keys (only set what you need)
GEMINI_API_KEY="your_gemini_api_key"

# Storage paths
VECTORSTORE_PATH="/path/to/vectorstore"
CACHE_FOLDER_PATH="/path/to/cache"
SQLITE_MEMORY_DATABASE="/path/to/db"

# Local model (required when LLM_PROVIDER=local or EMBEDDING_PROVIDER=local)
# Needs: NVIDIA GPU + CUDA 12.4+. Downloaded from HuggingFace on first run.
LOCAL_MODELS_PATH="/path/to/models"
LOCAL_MODEL_BITS=4

# Ports
WEB_PORT=8000
REDIS_PORT=6379
STREAMLIT_PORT=8501
REDIS_COMMANDER_PORT=8081  # docker compose --profile dev only

# Frontend
API_BASE_URL="http://localhost:8000"  # must match WEB_PORT

# LangSmith (optional)
# LANGSMITH_API_KEY="your_key"
# LANGSMITH_PROJECT="vir-chatbot"
# LANGSMITH_TRACING_V2=true
# LANGSMITH_ENDPOINT="https://api.smith.langchain.com"

# Docker permissions (optional — run: id -u && id -g)
# PUID=1000
# PGID=1000
